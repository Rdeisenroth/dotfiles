-- Parents' house: ASUS OLED + Dells + laptop display.
hl.monitor({ output = "{{(index .MonitorsByTag "oled").Name}}", mode = "2560x1440@240", position = "0x0", scale = 1, bitdepth = 10 })
hl.monitor({ output = "{{(index .MonitorsByTag "dell_left").Name}}", mode = "2560x1440@60", position = "-2560x0", scale = 1 })
hl.monitor({ output = "{{(index .MonitorsByTag "dell_right").Name}}", mode = "2560x1440@60", position = "2560x0", scale = 1 })
hl.monitor({ output = "{{(index .MonitorsByTag "laptop").Name}}", mode = "1920x1080@144", position = "-2240x1440", scale = 1 })
