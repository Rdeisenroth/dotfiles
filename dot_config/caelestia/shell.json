{
    "bar": {
        "excludedScreens": [
            "^.*$"
        ],
        "persistent": false,
        "showOnHover": false
    },
    "border": {
        "thickness": 0,
        "rounding": 0,
        "smoothing": 1
    },
    "background": {
        "enabled": false
    },
