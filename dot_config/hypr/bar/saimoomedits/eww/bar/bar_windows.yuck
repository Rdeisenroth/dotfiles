; Bar for monitor 0
(defwindow bar0
  :exclusive true
  :monitor 0
  :windowtype "dock"
  :stacking "fg"
  :vexpand false
  :hexpand false
  :geometry (geometry :x "0%"
    :y "0%"
    :width "100%"
    :height "4%"
  :anchor "top center")
  ; :reserve (struts :side "top" :distance "4%")
  (bar_1))
