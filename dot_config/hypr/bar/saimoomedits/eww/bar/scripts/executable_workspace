#!/bin/bash
workspaces() {

    # Active Monitor
    activeMonitor=$(hyprctl monitors -j | jq -r '.[] | select(.focused==true)')
    activeMonitorName=$(jq -r '.name' <<<$activeMonitor)
    activeMonitorId=$(jq -r '.id' <<<$activeMonitor)
    activeWorkspaceId=$(jq -r '.activeWorkspace | .id' <<<$activeMonitor)
    # The plugin uses global IDs (1..10, 11..20, ...), but the bar displays
    # the local 1..10 number for the active monitor.
    workspaceCount=10
    activeWorkspaceNumber=$(( (activeWorkspaceId - 1) % workspaceCount + 1 ))

    unoccupiedSym="○"
    occupiedSym="◎"
    activeSym="◉"

    # check if Occupied
    occupiedList=$(hyprctl workspaces -j | jq -r --arg activeMonitorName "$activeMonitorName" 'map(select(.monitor == $activeMonitorName and .windows > 0)) | .[].id | tostring')

    # Unoccupied
    un="0"

    buttons=""
    for num in {1..10}; do
        local BTN_ICO=$unoccupiedSym
        local occupied=0
        local focused=0
        local wid=$num
        # active?
        if [ "$activeWorkspaceNumber" -eq "$wid" ]; then
            focused=1
            BTN_ICO=$activeSym
        # occupied?
        elif echo "$occupiedList" | awk -v count="$workspaceCount" '{print (($0 - 1) % count) + 1}' | grep -qx "$wid"; then
            occupied=1
            BTN_ICO=$occupiedSym
        fi
        buttons="$buttons (button :onclick \"hyprctl eval 'split_workspace($num)'\"	:class \"$un$occupied$focused\"	\"$BTN_ICO\")"
        # echo "wid: $wid, id: $num, occupied: $occupied, focused: $focused, icon: $BTN_ICO"
    done

    # Old hyprsplit button dispatch, retained for rollback:
    # buttons="$buttons (button :onclick \"hyprctl dispatch split:workspace $num\" :class \"$un$occupied$focused\" \"$BTN_ICO\")"

    echo "(eventbox :onscroll \"bash ~/.config/hypr/bar/saimoomedits/eww/bar/scripts/workspace_scroll {}\" :class \"workspaces-widget\"(box	:class \"works\"	:orientation \"h\" :spacing 5 :space-evenly \"false\" $buttons))"

}
workspaces
socat -u UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock - | while read -r line; do
    workspaces
done
