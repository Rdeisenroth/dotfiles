#! /bin/bash
# Scroll through the focused monitor's workspaces (1..10), used by the eww bar.
# Uses split_workspace() from ~/.config/hypr/workspaces.lua.

direction=$1
activeWorkspaceId=$(hyprctl monitors -j | jq -r '.[] | select(.focused==true) | .activeWorkspace.id')
# Global ID -> per-monitor index (e.g. 23 -> 3, 30 -> 10)
index=$(( (activeWorkspaceId - 1) % 10 + 1 ))

case "$direction" in
    down) target=$(( index + 1 )) ;;
    up)   target=$(( index - 1 )) ;;
    *)    echo "invalid direction"; exit 1 ;;
esac

(( target < 1 ))  && target=1
(( target > 10 )) && target=10

hyprctl eval "split_workspace($target)"
